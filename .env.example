# Example configuration. All variables are optional; defaults are shown.
# Copy to `.env` and adjust, or export these in your shell before running
# (the app/CLI read the process environment directly -- .env is not auto-loaded).

# --- Data fetching and caching ---
SCREENER_CACHE_DIR=.cache
SCREENER_CACHE_TTL_HOURS=24
SCREENER_MAX_RETRIES=4
SCREENER_BACKOFF_SECONDS=1.0
SCREENER_REQUEST_DELAY_SECONDS=0.25
SCREENER_FUNDAMENTALS_MAX_WORKERS=8
# Fundamentals (market cap, sector, beta, dividend yield) barely move, so they
# cache longer than prices. Keep this high to lower CACHE_TTL_HOURS for fresh
# prices without re-issuing hundreds of per-ticker fundamentals calls.
SCREENER_FUNDAMENTALS_TTL_HOURS=24

# --- Indicator windows ---
SCREENER_MIN_AVG_VOLUME=500000
SCREENER_RSI_PERIOD=14
SCREENER_SMA_SHORT_WINDOW=50
SCREENER_SMA_LONG_WINDOW=200
SCREENER_EMA_WINDOW=20
SCREENER_VOLUME_WINDOW=50
SCREENER_ATR_PERIOD=14
SCREENER_ATR_STOP_MULTIPLIER=2.0

# --- Signal model & screening gates ---
# ma_dc_volume_regime (default) or ma_dc_volume (no risk-off breakout suppression).
SCREENER_SIGNAL_MODEL=ma_dc_volume_regime
SCREENER_REC_MIN_CONFIDENCE=80
SCREENER_REC_MIN_REWARD_RISK=2.5
# Suppress recommendations while the market is risk-off (SPY below its 200-day).
# Backtests show entries below the 200-day roughly halve expectancy. Set false
# to keep surfacing candidates regardless of regime.
SCREENER_REQUIRE_REGIME_FOR_ADDS=true

# --- Daily snapshot script (scripts/generate_snapshot.py) ---
# 0 = screen the full S&P 500; a positive value caps the universe size.
SCREENER_SNAPSHOT_SYMBOLS=0
SCREENER_SNAPSHOT_LIMIT=20
