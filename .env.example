# Example configuration. All variables are optional; defaults are shown.
# Copy to `.env` and adjust, or export these in your shell before running.

# --- Data fetching and caching ---
SCREENER_CACHE_DIR=.cache
SCREENER_CACHE_TTL_HOURS=24
SCREENER_MAX_RETRIES=4
SCREENER_BACKOFF_SECONDS=1.0
SCREENER_REQUEST_DELAY_SECONDS=0.25
SCREENER_FUNDAMENTALS_MAX_WORKERS=8
# Fundamentals (market cap, sector, exchange) barely move, so they cache longer
# than prices. Keep this high to lower CACHE_TTL_HOURS for fresh prices without
# re-issuing hundreds of per-ticker fundamentals calls (the main throttle risk).
SCREENER_FUNDAMENTALS_TTL_HOURS=24

# --- Indicator windows ---
SCREENER_MIN_AVG_VOLUME=500000
SCREENER_RSI_PERIOD=14
SCREENER_SMA_SHORT_WINDOW=50
SCREENER_SMA_LONG_WINDOW=200
SCREENER_EMA_WINDOW=20
SCREENER_VOLUME_WINDOW=50
SCREENER_ATR_PERIOD=14
SCREENER_ATR_STOP_MULTIPLIER=2.0

# --- UI and portfolio construction ---
SCREENER_PAGE_SIZE_DEFAULT=25
SCREENER_CORE_ALLOCATION=0.70
SCREENER_CORE_SCORE_THRESHOLD=0.60
SCREENER_MAX_POSITION_WEIGHT=0.10

# Recommended adds at/above this confidence are appended to watchlist.txt
# automatically by scripts/daily_report.py.
SCREENER_WATCHLIST_AUTO_CONFIDENCE=80

# First-run lookback (days) for the daily report's "Income to reconcile" digest.
# After the first run a per-ticker watermark surfaces each new ex-date once.
SCREENER_DIVIDEND_LOOKBACK_DAYS=7

# Starter-tranche fraction of the risk-based max add to suggest as a first entry
# (0 < f <= 1). 0.5 = stage half now, scale the rest on confirmation.
SCREENER_SUGGESTED_ADD_FRACTION=0.5

# Confirmation level (in R) at which to add the remaining tranche and move the
# stop to breakeven. Backtests favor +1.0R over adding earlier (whipsaw).
SCREENER_SUGGESTED_ADD_TRIGGER_R=1.0

# Heads-up band for the "Watch (scale-out)" line in the daily plan: flag a
# satellite holding when price is within this fraction below its nearest
# scale-out level (+2R or extended). 0.03 = within 3%.
SCREENER_SCALEOUT_ALERT_PCT=0.03

# Swing-trading management for satellites (cores unaffected). On by default:
# emits explicit Cut / Take profit (+2R, extended, target) / Trail verbs. Set
# false for long-only Hold/Trim hints.
SCREENER_SWING_MODE=true

# --- Daily snapshot script (scripts/generate_snapshot.py) ---
# 0 = screen the full S&P 500; a positive value caps the universe size.
SCREENER_SNAPSHOT_SYMBOLS=0
SCREENER_SNAPSHOT_LIMIT=20
